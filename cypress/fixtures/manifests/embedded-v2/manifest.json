			"@type": "sc:Canvas",
			"label": { "en": ["Cal y Canto"] },
			"summary": { "en": ["Cal y Canto is a play on words derived from the idiom \"cerrado a cal y canto,\" meaning \"under lock and key\" or \"locked tight.\" The earth-colored linen strips are woven together to create a somber barricade, reminiscent of ancient Incan stonework. The white gesso, irregularly applied, suggests the weathered face of the ancient structures."] },
			"metadata": [
			  {
				"label": { "en": ["Last slide description"] },
				"value": { "en": ["ca. 1979. Smithsonian American Art Museum, Gift from the collection of Dr. and Mrs. Isidore M. Samuels."] }
			  }
